apiVersion: apps/v1
kind: Deployment 
metadata:
  name: nginxfirst  
  namespace: default   
  labels:
    app: nginx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: nginx
    
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx-container
        image: nginx:stable-alpine3.23
        ports:
        - containerPort: 8000
